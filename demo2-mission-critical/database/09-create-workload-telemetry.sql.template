/*
    Approval-gated serverless workload telemetry for antho-caldova/research.

    Each scheduled run records one row so auto-pause and resume behaviour can be
    reconstructed after the 14-day window without external monitoring.
*/

SET NOCOUNT ON;
SET XACT_ABORT ON;

DECLARE @DeploymentApproved BIT = 0;
DECLARE @ServerName NVARCHAR(128) = LOWER(CONVERT(NVARCHAR(128), SERVERPROPERTY('ServerName')));

IF @DeploymentApproved <> 1
    THROW 51240, 'Deployment is blocked. Set @DeploymentApproved = 1 only after explicit approval.', 1;

IF LOWER(DB_NAME()) <> N'research'
    THROW 51241, 'This schema may be applied only to the research database.', 1;

IF @ServerName <> N'antho-caldova'
   AND @ServerName NOT LIKE N'antho-caldova.%'
    THROW 51242, 'This schema may be applied only to the antho-caldova logical server.', 1;

BEGIN TRY
    BEGIN TRANSACTION;

    IF OBJECT_ID(N'dbo.CaldovaWorkloadRun', N'U') IS NULL
    BEGIN
        CREATE TABLE dbo.CaldovaWorkloadRun
        (
            RunId BIGINT IDENTITY(1,1) NOT NULL,
            StartedAtUtc DATETIME2(0) NOT NULL,
            Intensity VARCHAR(16) NOT NULL,
            ConnectAttempts INT NOT NULL,
            ConnectMilliseconds INT NOT NULL,
            ResumeObserved BIT NOT NULL,
            QueryCount INT NOT NULL,
            Concurrency INT NOT NULL,
            MedianQueryMilliseconds INT NOT NULL,
            P95QueryMilliseconds INT NOT NULL,
            TotalMilliseconds INT NOT NULL,
            FailedQueries INT NOT NULL,
            RecordedAtUtc DATETIME2(0) NOT NULL
                CONSTRAINT DF_CaldovaWorkloadRun_RecordedAtUtc DEFAULT SYSUTCDATETIME(),
            CONSTRAINT PK_CaldovaWorkloadRun
                PRIMARY KEY CLUSTERED (RunId),
            CONSTRAINT CK_CaldovaWorkloadRun_Intensity
                CHECK (Intensity IN ('light', 'medium', 'heavy')),
            CONSTRAINT CK_CaldovaWorkloadRun_ConnectAttempts
                CHECK (ConnectAttempts > 0),
            CONSTRAINT CK_CaldovaWorkloadRun_QueryCount
                CHECK (QueryCount >= 0),
            CONSTRAINT CK_CaldovaWorkloadRun_Concurrency
                CHECK (Concurrency > 0),
            CONSTRAINT CK_CaldovaWorkloadRun_FailedQueries
                CHECK (FailedQueries >= 0)
        );

        CREATE NONCLUSTERED INDEX IX_CaldovaWorkloadRun_StartedAtUtc
            ON dbo.CaldovaWorkloadRun (StartedAtUtc)
            INCLUDE (Intensity, ResumeObserved, ConnectMilliseconds);
    END;

    IF DATABASE_PRINCIPAL_ID(N'CaldovaWorkloadWriter') IS NULL
        CREATE ROLE CaldovaWorkloadWriter AUTHORIZATION dbo;

    GRANT SELECT, INSERT ON OBJECT::dbo.CaldovaWorkloadRun TO CaldovaWorkloadWriter;

    COMMIT TRANSACTION;
END TRY
BEGIN CATCH
    IF XACT_STATE() <> 0
        ROLLBACK TRANSACTION;
    THROW;
END CATCH;
