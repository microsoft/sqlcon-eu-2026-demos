/*
    Approval-gated version 3 cosine DiskANN index for the Caldova Potion lane.

    Run the same checked-in script on the small and large targets only after the
    identical staged Potion rows have passed count and hash reconciliation.
*/

SET NOCOUNT ON;
SET XACT_ABORT ON;

DECLARE @DeploymentApproved BIT = 0;

IF @DeploymentApproved <> 1
    THROW 51210, 'Index creation is blocked. Set @DeploymentApproved = 1 only after explicit approval.', 1;

IF OBJECT_ID(N'dbo.CaldovaVectorContract', N'U') IS NULL
    THROW 51211, 'dbo.CaldovaVectorContract is missing.', 1;

IF OBJECT_ID(N'dbo.CaldovaPotionEmbedding', N'U') IS NULL
    THROW 51212, 'dbo.CaldovaPotionEmbedding is missing.', 1;

IF NOT EXISTS
(
    SELECT 1
    FROM dbo.CaldovaVectorContract AS contract
    WHERE contract.ContractId = 1
    AND contract.SchemaVersion = 'caldova-pmc-potion512-v1'
      AND contract.EmbeddingModel = 'minishlab/potion-retrieval-32M'
      AND contract.EmbeddingRuntime = 'model2vec'
      AND contract.EmbeddingRuntimeVersion = '0.9.0'
      AND contract.EmbeddingDimensions = 512
      AND contract.EmbeddingDataType = 'float32'
      AND contract.DistanceMetric = 'COSINE'
)
    THROW 51213, 'The database does not declare the required Potion vector contract.', 1;

IF (SELECT COUNT_BIG(*) FROM dbo.CaldovaPotionEmbedding) <> 1000
    THROW 51214, 'Exactly 1,000 source-reconciled Potion vectors are required before index creation.', 1;

IF NOT EXISTS
(
    SELECT 1
    FROM sys.vector_indexes AS vector_index
    INNER JOIN sys.indexes AS index_definition
        ON index_definition.object_id = vector_index.object_id
       AND index_definition.index_id = vector_index.index_id
        WHERE vector_index.object_id = OBJECT_ID(N'dbo.CaldovaPotionEmbedding')
            AND index_definition.name = N'IX_CaldovaPotionEmbedding_Embedding'
)
BEGIN
        CREATE VECTOR INDEX IX_CaldovaPotionEmbedding_Embedding
                ON dbo.CaldovaPotionEmbedding (Embedding)
        WITH (METRIC = 'COSINE', TYPE = 'DISKANN');
END;

IF NOT EXISTS
(
    SELECT 1
    FROM sys.vector_indexes AS vector_index
    INNER JOIN sys.indexes AS index_definition
        ON index_definition.object_id = vector_index.object_id
       AND index_definition.index_id = vector_index.index_id
    INNER JOIN sys.index_columns AS index_column
        ON index_column.object_id = vector_index.object_id
       AND index_column.index_id = vector_index.index_id
    INNER JOIN sys.columns AS column_definition
        ON column_definition.object_id = index_column.object_id
       AND column_definition.column_id = index_column.column_id
        WHERE vector_index.object_id = OBJECT_ID(N'dbo.CaldovaPotionEmbedding')
            AND index_definition.name = N'IX_CaldovaPotionEmbedding_Embedding'
      AND column_definition.name = N'Embedding'
      AND vector_index.distance_metric = 'COSINE'
      AND JSON_VALUE(vector_index.build_parameters, '$.Version') = '3'
      AND index_definition.is_disabled = 0
      AND index_definition.is_hypothetical = 0
)
    THROW 51215, 'The expected online cosine DiskANN version 3 index was not found.', 1;
