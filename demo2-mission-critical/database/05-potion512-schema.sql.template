/*
    Approval-gated schema for the Caldova Potion lane.

    This script is intentionally separate from the historical 384-dimensional
    schema. Change @DeploymentApproved only after the target and data migration
    have explicit approval. Running the checked-in file cannot mutate a database.
*/

SET NOCOUNT ON;
SET XACT_ABORT ON;

DECLARE @DeploymentApproved BIT = 0;

IF @DeploymentApproved <> 1
    THROW 51200, 'Deployment is blocked. Set @DeploymentApproved = 1 only after explicit approval.', 1;

IF DB_NAME() IS NULL
    THROW 51201, 'The target database could not be identified.', 1;

IF (SELECT compatibility_level FROM sys.databases WHERE database_id = DB_ID()) < 170
    THROW 51202, 'Compatibility level 170 or later is required.', 1;

IF OBJECT_ID(N'dbo.pmc_chunks', N'U') IS NULL
    THROW 51203, 'The source table dbo.pmc_chunks is required and will not be created or altered.', 1;

IF OBJECT_ID(N'dbo.pmc_documents', N'U') IS NULL
    THROW 51204, 'The metadata table dbo.pmc_documents is required and will not be created or altered.', 1;

IF NOT EXISTS
(
    SELECT 1
    FROM sys.indexes AS index_definition
    INNER JOIN sys.index_columns AS first_key
        ON first_key.object_id = index_definition.object_id
       AND first_key.index_id = index_definition.index_id
       AND first_key.key_ordinal = 1
    INNER JOIN sys.columns AS first_column
        ON first_column.object_id = first_key.object_id
       AND first_column.column_id = first_key.column_id
    INNER JOIN sys.index_columns AS second_key
        ON second_key.object_id = index_definition.object_id
       AND second_key.index_id = index_definition.index_id
       AND second_key.key_ordinal = 2
    INNER JOIN sys.columns AS second_column
        ON second_column.object_id = second_key.object_id
       AND second_column.column_id = second_key.column_id
    WHERE index_definition.object_id = OBJECT_ID(N'dbo.pmc_chunks')
      AND index_definition.is_primary_key = 1
      AND index_definition.is_unique = 1
      AND first_column.name = N'document_id'
      AND TYPE_NAME(first_column.user_type_id) = N'int'
      AND second_column.name = N'chunk_number'
      AND TYPE_NAME(second_column.user_type_id) = N'int'
)
    THROW 51205, 'dbo.pmc_chunks must have its int (document_id, chunk_number) primary key.', 1;

BEGIN TRY
    BEGIN TRANSACTION;

    IF OBJECT_ID(N'dbo.CaldovaVectorContract', N'U') IS NULL
    BEGIN
        CREATE TABLE dbo.CaldovaVectorContract
        (
            ContractId TINYINT NOT NULL,
            SchemaVersion VARCHAR(64) NOT NULL,
            EmbeddingModel VARCHAR(128) NOT NULL,
            EmbeddingRuntime VARCHAR(32) NOT NULL,
            EmbeddingRuntimeVersion VARCHAR(32) NOT NULL,
            EmbeddingDimensions SMALLINT NOT NULL,
            EmbeddingDataType VARCHAR(16) NOT NULL,
            DistanceMetric VARCHAR(16) NOT NULL,
            AppliedAtUtc DATETIME2(0) NOT NULL
                CONSTRAINT DF_CaldovaVectorContract_AppliedAtUtc DEFAULT SYSUTCDATETIME(),
            CONSTRAINT PK_CaldovaVectorContract
                PRIMARY KEY CLUSTERED (ContractId),
            CONSTRAINT CK_CaldovaVectorContract_ContractId
                CHECK (ContractId = 1),
            CONSTRAINT CK_CaldovaVectorContract_SchemaVersion
                CHECK (SchemaVersion = 'caldova-pmc-potion512-v1'),
            CONSTRAINT CK_CaldovaVectorContract_EmbeddingModel
                CHECK (EmbeddingModel = 'minishlab/potion-retrieval-32M'),
            CONSTRAINT CK_CaldovaVectorContract_EmbeddingRuntime
                CHECK (EmbeddingRuntime = 'model2vec'),
            CONSTRAINT CK_CaldovaVectorContract_EmbeddingRuntimeVersion
                CHECK (EmbeddingRuntimeVersion = '0.9.0'),
            CONSTRAINT CK_CaldovaVectorContract_EmbeddingDimensions
                CHECK (EmbeddingDimensions = 512),
            CONSTRAINT CK_CaldovaVectorContract_EmbeddingDataType
                CHECK (EmbeddingDataType = 'float32'),
            CONSTRAINT CK_CaldovaVectorContract_DistanceMetric
                CHECK (DistanceMetric = 'COSINE')
        );
    END;

    IF EXISTS
    (
        SELECT 1
        FROM dbo.CaldovaVectorContract AS contract
        WHERE contract.ContractId = 1
          AND
          (
              contract.SchemaVersion <> 'caldova-pmc-potion512-v1'
              OR contract.EmbeddingModel <> 'minishlab/potion-retrieval-32M'
              OR contract.EmbeddingRuntime <> 'model2vec'
              OR contract.EmbeddingRuntimeVersion <> '0.9.0'
              OR contract.EmbeddingDimensions <> 512
              OR contract.EmbeddingDataType <> 'float32'
              OR contract.DistanceMetric <> 'COSINE'
          )
    )
        THROW 51206, 'An incompatible Caldova vector contract already exists.', 1;

    IF NOT EXISTS
    (
        SELECT 1
        FROM dbo.CaldovaVectorContract AS contract
        WHERE contract.ContractId = 1
    )
    BEGIN
        INSERT dbo.CaldovaVectorContract
        (
            ContractId,
            SchemaVersion,
            EmbeddingModel,
            EmbeddingRuntime,
            EmbeddingRuntimeVersion,
            EmbeddingDimensions,
            EmbeddingDataType,
            DistanceMetric
        )
        VALUES
        (
            1,
            'caldova-pmc-potion512-v1',
            'minishlab/potion-retrieval-32M',
            'model2vec',
            '0.9.0',
            512,
            'float32',
            'COSINE'
        );
    END;

    IF OBJECT_ID(N'dbo.CaldovaPotionEmbedding', N'U') IS NULL
    BEGIN
        CREATE TABLE dbo.CaldovaPotionEmbedding
        (
            DocumentId INT NOT NULL,
            ChunkNumber INT NOT NULL,
            SourceContentSha256 BINARY(32) NOT NULL,
            Embedding VECTOR(512) NOT NULL,
            EmbeddingSha256 BINARY(32) NOT NULL,
            LoadedAtUtc DATETIME2(0) NOT NULL
                CONSTRAINT DF_CaldovaPotionEmbedding_LoadedAtUtc DEFAULT SYSUTCDATETIME(),
            CONSTRAINT PK_CaldovaPotionEmbedding
                PRIMARY KEY CLUSTERED (DocumentId, ChunkNumber),
            CONSTRAINT UQ_CaldovaPotionEmbedding_EmbeddingSha256
                UNIQUE (EmbeddingSha256),
            CONSTRAINT CK_CaldovaPotionEmbedding_DocumentId
                CHECK (DocumentId > 0),
            CONSTRAINT CK_CaldovaPotionEmbedding_ChunkNumber
                CHECK (ChunkNumber >= 0)
        );
    END;

    IF DATABASE_PRINCIPAL_ID(N'CaldovaSearchReader') IS NULL
        CREATE ROLE CaldovaSearchReader AUTHORIZATION dbo;

    GRANT SELECT ON OBJECT::dbo.CaldovaVectorContract TO CaldovaSearchReader;
    GRANT SELECT ON OBJECT::dbo.CaldovaPotionEmbedding TO CaldovaSearchReader;
    GRANT SELECT ON OBJECT::dbo.pmc_chunks TO CaldovaSearchReader;
    GRANT SELECT ON OBJECT::dbo.pmc_documents TO CaldovaSearchReader;

    COMMIT TRANSACTION;
END TRY
BEGIN CATCH
    IF XACT_STATE() <> 0
        ROLLBACK TRANSACTION;
    THROW;
END CATCH;
